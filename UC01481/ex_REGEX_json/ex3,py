import json
import re

with open("E:/DEV/Rodrigo_Freitas_CISEG1025/UC01481/ex_REGEX_json/dados.json", "r") as ficheiro:
    listaDados = json.load(ficheiro)


regexSite = r"https?://([\w\.-]+)"
print("=== Domínios extraídos ===")
for registo in listaDados:
    site = registo["site"]
    match = re.match(regexSite, site)
    if match:
        dominio = match.group(1)
        print(f"Domínio: {dominio}")
print("\n")